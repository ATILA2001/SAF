@inherits LayoutComponentBase
@implements IDisposable
<RadzenComponents @rendermode="InteractiveServer" />

<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="Radzen.AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
            <RadzenSidebarToggle Click="@(() => sidebarExpanded = !sidebarExpanded)" />

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" JustifyContent="JustifyContent.Right">
                <AuthorizeView>
                    <Authorized>
                        <RadzenLabel Text="@context.User.Identity?.Name" />
                    </Authorized>
                </AuthorizeView>
                @if (_otherApps.Count > 0)
                {
                    <div style="position: relative; display: inline-block;">
                        <RadzenButton Text="Aplicaciones"
                                      Icon="grid_view"
                                      ButtonStyle="ButtonStyle.Secondary"
                                      Click="@ToggleAppSwitcher" />
                        @if (_appSwitcherOpen)
                        {
                            <div style="position: absolute; right: 0; top: calc(100% + 4px); min-width: 220px; z-index: 1000;
                                        background: var(--rz-overlay-background-color); border: var(--rz-overlay-border);
                                        border-radius: var(--rz-border-radius); box-shadow: var(--rz-overlay-shadow); overflow: hidden;">
                                @foreach (var app in _otherApps)
                                {
                                    <a href="@app.Url"
                                       style="display: block; padding: 10px 16px; text-decoration: none; color: var(--rz-text-color);"
                                       @onclick="@(() => _appSwitcherOpen = false)">@app.Label</a>
                                }
                            </div>
                        }
                    </div>
                }
                <RadzenAppearanceToggle />
                <RadzenButton Icon="logout"
                              Text="Salir"
                              ButtonStyle="ButtonStyle.Danger"
                              Click="@(() => Navigation.NavigateTo("/Account/Logout", forceLoad: true))" />
            </RadzenStack>
        </RadzenStack>
    </RadzenHeader>
    <RadzenSidebar Responsive="false" Style="width: max-content">
        <RadzenPanelMenu DisplayStyle="@(sidebarExpanded? Radzen.MenuItemDisplayStyle.IconAndText : Radzen.MenuItemDisplayStyle.Icon)" ShowArrow="false">
            <RadzenPanelMenuItem Text="Inicio" Icon="home" Path="/home" />
            @if (CanShowPage("/pagos"))
            {
                <RadzenPanelMenuItem Text="Pagos" Icon="payments" Path="/pagos" />
            }
            @if (CanShowPage("/status-contabilidad"))
            {
                <RadzenPanelMenuItem Text="Status Contabilidad" Icon="account_balance" Path="/status-contabilidad" />
            }
            @if (CanShowPage("/caf"))
            {
                <RadzenPanelMenuItem Text="CAF" Icon="request_quote" Path="/caf" />
            }
            @if (CanShowPage("/seguros"))
            {
                <RadzenPanelMenuItem Text="Seguros" Icon="verified_user" Path="/seguros" />
            }
            @if (CanShowPage("/admin/listas"))
            {
                <RadzenPanelMenuItem Text="Listas" Icon="checklist" Path="/admin/listas" />
            }
        </RadzenPanelMenu>
    </RadzenSidebar>
    <RadzenBody>
        @Body
    </RadzenBody>
</RadzenLayout>
