@page "/seguros"
@inherits SAF.Components.GridPageBase<SAF.Application.Seguros.Dtos.SeguroViewModel>

<PageTitle>Seguros</PageTitle>

<RadzenStack>
    <GridToolbar Titulo="Seguros"
                 SizeTitulo="3"
                 SizeAcciones="9"
                 OnBuscar="@OnBusquedaChanged"
                 TextoBusqueda="@_textoBusqueda"
                 PlaceholderBusqueda="Buscar expediente, OP o beneficiario…"
                 LimpiarFiltrosDeshabilitado="@(!HayFiltrosActivos)"
                 MostrarNuevo="@CanCreate"
                 NuevoDeshabilitado="@_loading"
                 OnNuevo="@AddRow"
                 CargandoResto="@_cargandoResto"
                 Exportando="@_exportando"
                 ExportarDeshabilitado="@ExportarDeshabilitado"
                 TituloExportarDeshabilitado="@MotivoExportarDeshabilitado"
                 OnExportar="@ExportarExcel"
                 OnLimpiarFiltros="@LimpiarFiltros" />

    @if (_loading)
    {
        <EstadoCarga Texto="@($"Cargando {TituloEntidad}…")" />
    }
    else
    {
        @* Virtualización en lugar de paginado: scroll continuo (como la planilla)
           renderizando solo las filas visibles. Requiere el alto fijo del Style. *@
        <RadzenDataGrid @ref="_grid"
                        Data="@ItemsVisibles"
                        TItem="SAF.Application.Seguros.Dtos.SeguroViewModel"
                        Filter="@OnGridFilter"
                        FilterCleared="@OnGridFilter"
                        AllowFiltering="true"
                        AllowSorting="true"
                        AllowColumnResize="true"
                        FilterMode="FilterMode.CheckBoxList"
                        ClearFilterText="Limpiar"
                        ApplyFilterText="Aplicar"
                        EmptyText="No hay filas para mostrar. Si aplicaste filtros, podés quitarlos con el botón de la barra superior."
                        AllowPaging="false"
                        AllowVirtualization="true"
                        Style="height: calc(100vh - 15rem)"
                        EditMode="DataGridEditMode.Single"
                        RowEdit="@OnRowEdit"
                        RowUpdate="@OnRowUpdate"
                        RowCreate="@OnRowCreate">
            <Columns>
                @* El expediente identifica la fila: queda fijo al scrollear (misma regla
                   que en Pagos, Status y CAF). *@
                <RadzenDataGridColumn TItem="SAF.Application.Seguros.Dtos.SeguroViewModel" Property="Expediente" Title="Expediente" Width="230px" Frozen="true">
                    <EditTemplate Context="item">
                        <ExpedienteEditor @bind-Value="Buffer(item).Expediente" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.Seguros.Dtos.SeguroViewModel" Property="Op" Title="OP" Width="130px">
                    <EditTemplate Context="item">
                        <RadzenTextBox @bind-Value="Buffer(item).Op" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.Seguros.Dtos.SeguroViewModel" Property="Beneficiario" Title="Beneficiario" Width="220px">
                    <EditTemplate Context="item">
                        <RadzenTextBox @bind-Value="Buffer(item).Beneficiario" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.Seguros.Dtos.SeguroViewModel" Property="ImporteNeto" Title="Importe Neto" Width="150px" FormatString="{0:N2}" TextAlign="TextAlign.Right">
                    <EditTemplate Context="item">
                        <RadzenNumeric @bind-Value="Buffer(item).ImporteNeto" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.Seguros.Dtos.SeguroViewModel" Property="Estado" Title="Estado" Width="150px">
                    <EditTemplate Context="item">
                        <RadzenTextBox @bind-Value="Buffer(item).Estado" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.Seguros.Dtos.SeguroViewModel" Property="SeguroNombre" Title="Seguro" Width="150px">
                    <EditTemplate Context="item">
                        <RadzenDropDown @bind-Value="Buffer(item).SeguroOpcionId"
                                        Data="@_seguroOpciones"
                                        TextProperty="Nombre"
                                        ValueProperty="Id"
                                        AllowClear="true"
                                        class="@GetValidationCssClass(Buffer(item).SeguroOpcionId is > 0)"
                                        Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                @if (CanEdit || CanDelete || CanCreate)
                {
                    <RadzenDataGridColumn TItem="SAF.Application.Seguros.Dtos.SeguroViewModel" Title="Acciones" Width="140px" Frozen="true" FrozenPosition="FrozenColumnPosition.Right" Filterable="false" Sortable="false">
                        <Template Context="item">
                            @if (CanEdit)
                            {
                                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                              Click="@(() => _grid.EditRow(item))" title="Editar fila" />
                            }
                            @if (CanDelete)
                            {
                                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                              Click="@(() => DeleteRow(item))" title="Eliminar fila" />
                            }
                            <RadzenButton Icon="history" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                          Click="@(() => VerHistorial(item))" title="Historial de cambios" />
                        </Template>
                        <EditTemplate Context="item">
                            <RadzenButton Icon="save" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small"
                                          Click="@(() => GuardarFila(item))" title="Guardar cambios" />
                            <RadzenButton Icon="cancel" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                          Click="@(() => CancelEdit(item))" title="Cancelar edición" />
                        </EditTemplate>
                    </RadzenDataGridColumn>
                }
            </Columns>
            <FooterTemplate>
                @* View y no _items: es lo que queda a la vista con los filtros aplicados. *@
                <GridFooterTotales Filas="@(_grid?.View?.Count() ?? 0)"
                                   TotalFilas="@_items.Count"
                                   Importe="@(_grid?.View?.Sum(x => x.ImporteNeto ?? 0m) ?? 0m)"
                                   Cargando="@_cargandoResto"
                                   CargaIncompleta="@_cargaIncompleta" />
            </FooterTemplate>
        </RadzenDataGrid>
    }
</RadzenStack>
