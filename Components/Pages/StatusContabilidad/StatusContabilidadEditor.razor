@using SAF.Application.StatusContabilidad.Dtos
@using SAF.Data.Entities

@* Edición de la fila del tablero en ventana, con panel de identidad (opción C del
   rediseño): columna verde fija con el devengado, expediente, empresa e importe
   siempre visibles —y los hitos del proceso abajo—, y el formulario a la derecha.
   Escribe sobre el mismo Borrador (buffer) que la edición inline: cerrar o
   cancelar descarta sin tocar la fila; los permisos por área deshabilitan campos.
   Requiere DialogOptions con ShowTitle=false y CssClass "saf-dialog-panel" (el
   contenido va de borde a borde). *@

@* min-height: el diálogo abre con aire aunque el contenido sea corto; la botonera
   se ancla abajo (margin-top auto) y el sobrante queda en el formulario. *@
<div style="display: flex; align-items: stretch; min-height: 640px;">

    <div style="width: 280px; flex-shrink: 0; background: var(--rz-primary-dark); color: #ffffff; padding: 26px 24px; display: flex; flex-direction: column; gap: 22px; box-sizing: border-box;">
        <div style="display: flex; flex-direction: column; gap: 4px;">
            <span style="font-size: 0.65rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255,255,255,0.55);">Devengado</span>
            <span style="font-size: 1.6rem; font-weight: 700;">@Item.TipoDev @Item.NroDev</span>
        </div>
        <div style="height: 1px; background: rgba(255,255,255,0.16);"></div>
        <div style="display: flex; flex-direction: column; gap: 4px;">
            <span style="font-size: 0.65rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255,255,255,0.55);">Expediente</span>
            <span style="font-size: 0.95rem; font-weight: 500; font-variant-numeric: tabular-nums; overflow-wrap: anywhere;">@Item.Expediente</span>
        </div>
        <div style="display: flex; flex-direction: column; gap: 4px;">
            <span style="font-size: 0.65rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255,255,255,0.55);">Empresa</span>
            <span style="font-size: 0.9rem; line-height: 1.45;">@Item.Empresa</span>
        </div>
        <div style="display: flex; flex-direction: column; gap: 4px;">
            <span style="font-size: 0.65rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255,255,255,0.55);">Importe</span>
            <span style="font-size: 1.3rem; font-weight: 700; color: var(--custom-primary-accent); font-variant-numeric: tabular-nums;">@(Item.ImporteTotal?.ToString("N2") ?? "—")</span>
        </div>
        <div style="flex-grow: 1;"></div>
        @* Hitos del proceso ya cumplidos, como contexto de la cronología (el pedido 1
           no se edita en ninguna parte: vive acá y no como campo deshabilitado). *@
        <div style="display: flex; flex-direction: column; gap: 8px;">
            @if (Item.FechaPedidoFactura1 is DateTime ped1)
            {
                <div style="display: flex; align-items: center; gap: 8px;">
                    <div style="width: 8px; height: 8px; border-radius: 50%; background: var(--custom-primary-accent); flex-shrink: 0;"></div>
                    <span style="font-size: 0.75rem; color: rgba(255,255,255,0.75);">Pedido 1 · @ped1.ToString("dd/MM/yyyy")</span>
                </div>
            }
            @if (Item.FechaIngresoFactura is DateTime ingreso)
            {
                <div style="display: flex; align-items: center; gap: 8px;">
                    <div style="width: 8px; height: 8px; border-radius: 50%; background: var(--custom-primary-accent); flex-shrink: 0;"></div>
                    <span style="font-size: 0.75rem; color: rgba(255,255,255,0.75);">Factura ingresada · @ingreso.ToString("dd/MM/yyyy")</span>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(Item.SinFacturaMotivo))
            {
                <div style="display: flex; align-items: center; gap: 8px;">
                    <div style="width: 8px; height: 8px; border-radius: 50%; background: rgba(255,255,255,0.4); flex-shrink: 0;"></div>
                    <span style="font-size: 0.75rem; color: rgba(255,255,255,0.75);">Sin factura · @Item.SinFacturaMotivo</span>
                </div>
            }
        </div>
    </div>

    <div style="flex-grow: 1; display: flex; flex-direction: column; min-width: 0;">
        <div style="display: flex; align-items: center; justify-content: space-between; padding: 16px 24px 0 24px;">
            <RadzenText TextStyle="TextStyle.H6" Style="margin: 0; font-size: 1.15rem;">Editar registro</RadzenText>
            <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Size="ButtonSize.Small"
                          Click="@(() => DialogService.Close(false))" title="Cerrar sin guardar" />
        </div>

        <div style="display: flex; flex-direction: column; gap: 20px; padding: 16px 24px 16px 24px;">
            <RadzenStack Gap="0.85rem">
                <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0;">
                    Cuentas a Pagar@(EditaCuentasPagar ? "" : " (solo lectura para tu área)")
                </RadzenText>
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="6">
                        <RadzenFormField Text="Fecha Ped. Factura 2" Variant="Variant.Outlined" Style="width: 100%;">
                            <RadzenDatePicker @bind-Value="Borrador.FechaPedidoFactura2" DateFormat="dd/MM/yyyy" Disabled="@(!EditaCuentasPagar)" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="6">
                        <RadzenFormField Text="Reit. Ped. Factura 3" Variant="Variant.Outlined" Style="width: 100%;">
                            <RadzenDatePicker @bind-Value="Borrador.ReiterarPedidoFactura3" DateFormat="dd/MM/yyyy" Disabled="@(!EditaCuentasPagar)" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="6">
                        <RadzenFormField Text="Ingreso Factura" Variant="Variant.Outlined" Style="width: 100%;">
                            <RadzenDatePicker @bind-Value="Borrador.FechaIngresoFactura" DateFormat="dd/MM/yyyy" AllowClear="true" Disabled="@(!EditaCuentasPagar)" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="6">
                        <RadzenFormField Text="Fecha de Rechazo" Variant="Variant.Outlined" Style="width: 100%;">
                            <RadzenDatePicker @bind-Value="Borrador.FechaRechazo" DateFormat="dd/MM/yyyy" AllowClear="true" Disabled="@(!EditaCuentasPagar)" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="6">
                        <RadzenFormField Text="Sin factura (motivo)" Variant="Variant.Outlined" Style="width: 100%;">
                            <RadzenDropDown @bind-Value="Borrador.SinFacturaMotivo" Data="@SinFacturaMotivos" AllowClear="true" Disabled="@(!EditaCuentasPagar)" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="6">
                        <RadzenFormField Text="Tramitador Ctas. Pagar" Variant="Variant.Outlined" Style="width: 100%;">
                            <RadzenDropDown @bind-Value="Borrador.TramitadorCuentasPagarOpcionId"
                                            Data="@TramitadoresCuentasPagar" TextProperty="Nombre" ValueProperty="Id"
                                            AllowClear="true" Disabled="@(!EditaCuentasPagar)" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenFormField Text="Obs. Ctas. a Pagar" Variant="Variant.Outlined" Style="width: 100%;">
                    <RadzenTextArea @bind-Value="Borrador.ObservacionesCuentasPagar" Rows="3" Disabled="@(!EditaCuentasPagar)" />
                </RadzenFormField>
            </RadzenStack>

            <RadzenStack Gap="0.85rem">
                <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0;">
                    Contabilidad y Liquidaciones@(EditaLiquidaciones ? "" : " (Liquidaciones en solo lectura para tu área)")
                </RadzenText>
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="6">
                        <RadzenFormField Text="Status Contable" Variant="Variant.Outlined" Style="width: 100%;">
                            <RadzenDropDown @bind-Value="Borrador.StatusContableOpcionId"
                                            Data="@StatusContableOpciones" TextProperty="Nombre" ValueProperty="Id"
                                            AllowClear="true" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="6">
                        <RadzenFormField Text="Tramitador Liquidaciones" Variant="Variant.Outlined" Style="width: 100%;">
                            <RadzenDropDown @bind-Value="Borrador.TramitadorLiquidacionesOpcionId"
                                            Data="@TramitadoresLiquidaciones" TextProperty="Nombre" ValueProperty="Id"
                                            AllowClear="true" Disabled="@(!EditaLiquidaciones)" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenFormField Text="Obs. Liquidaciones" Variant="Variant.Outlined" Style="width: 100%;">
                    <RadzenTextArea @bind-Value="Borrador.ObservacionesLiquidaciones" Rows="3" Disabled="@(!EditaLiquidaciones)" />
                </RadzenFormField>
            </RadzenStack>
        </div>

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem"
                     Style="padding: 16px 24px 20px 24px; border-top: 1px solid var(--surface-border, rgba(128,128,128,.25)); margin-top: auto;">
            <RadzenButton Text="Cancelar" ButtonStyle="ButtonStyle.Light" Click="@(() => DialogService.Close(false))" />
            <RadzenButton Text="Guardar cambios" ButtonStyle="ButtonStyle.Primary"
                          Click="@Guardar" IsBusy="@_guardando" BusyText="Guardando..." />
        </RadzenStack>
    </div>
</div>

@code {
    [Inject] private DialogService DialogService { get; set; } = null!;

    /// <summary>La fila real: identidad y valores de solo lectura del panel.</summary>
    [Parameter, EditorRequired] public StatusContabilidadViewModel Item { get; set; } = null!;

    /// <summary>El buffer de edición compartido con la grilla: acá escriben los campos.</summary>
    [Parameter, EditorRequired] public StatusContabilidadViewModel Borrador { get; set; } = null!;

    [Parameter] public bool EditaCuentasPagar { get; set; }
    [Parameter] public bool EditaLiquidaciones { get; set; }

    [Parameter] public IReadOnlyList<StatusContableOpcion> StatusContableOpciones { get; set; } = [];
    [Parameter] public IReadOnlyList<TramitadorCuentasPagarOpcion> TramitadoresCuentasPagar { get; set; } = [];
    [Parameter] public IReadOnlyList<TramitadorLiquidacionesOpcion> TramitadoresLiquidaciones { get; set; } = [];
    [Parameter] public IReadOnlyList<string> SinFacturaMotivos { get; set; } = [];

    /// <summary>
    /// Guardado delegado a la página (GuardarDesdeDialogoAsync): true = cerrar el
    /// diálogo; false = quedó abierto con lo tipeado (validación o error).
    /// </summary>
    [Parameter, EditorRequired] public Func<Task<bool>> GuardarAsync { get; set; } = null!;

    private bool _guardando;

    private async Task Guardar()
    {
        _guardando = true;
        try
        {
            if (await GuardarAsync()) DialogService.Close(true);
        }
        finally
        {
            _guardando = false;
        }
    }
}
