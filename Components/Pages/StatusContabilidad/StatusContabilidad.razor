@page "/status-contabilidad"
@inherits SAF.Components.GridPageBase<SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel>

<PageTitle>Status Contabilidad</PageTitle>

<RadzenStack>
    <GridToolbar Titulo="Status Contabilidad"
                 SizeTitulo="3"
                 SizeAcciones="9"
                 OnBuscar="@OnBusquedaChanged"
                 TextoBusqueda="@_textoBusqueda"
                 PlaceholderBusqueda="Buscar devengado, expediente o empresa…"
                 LimpiarFiltrosDeshabilitado="@(!HayFiltrosActivos)"
                 CargandoResto="@_cargandoResto"
                 TextoCargando="Completando datos de SADE…"
                 Exportando="@_exportando"
                 ExportarDeshabilitado="@ExportarDeshabilitado"
                 TituloExportarDeshabilitado="@MotivoExportarDeshabilitado"
                 OnExportar="@ExportarExcel"
                 OnLimpiarFiltros="@LimpiarFiltros" />

    @if (_loading)
    {
        <EstadoCarga Texto="@($"Cargando {TituloEntidad}…")" />
    }
    else
    {
        @* Virtualización en lugar de paginado: scroll continuo (como la planilla)
           renderizando solo las filas visibles. Requiere el alto fijo del Style. *@
        <RadzenDataGrid @ref="_grid"
                        Data="@ItemsVisibles"
                        TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel"
                        Filter="@OnGridFilter"
                        FilterCleared="@OnGridFilter"
                        AllowFiltering="true"
                        AllowSorting="true"
                        AllowColumnResize="true"
                        AllowColumnPicking="true"
                        ColumnsText="@GridTextos.Columnas"
                        AllColumnsText="@GridTextos.TodasLasColumnas"
                        ColumnsShowingText="@GridTextos.ColumnasMostradas"
                        FilterMode="FilterMode.CheckBoxList"
                        ClearFilterText="@GridTextos.LimpiarFiltro"
                        ApplyFilterText="@GridTextos.AplicarFiltro"
                        EmptyText="@GridTextos.Vacio"
                        AllowPaging="false"
                        AllowVirtualization="true"
                        Style="height: calc(100vh - 15rem)"
                        EditMode="DataGridEditMode.Single"
                        RowEdit="@OnRowEdit"
                        RowUpdate="@OnRowUpdate"
                        CellRender="@OnCellRender">
            <Columns>
                @* Las columnas hasta Importe quedan fijas al scrollear horizontalmente y
                   fuera del selector de columnas: identifican la fila, no pueden faltar. *@
                @* Anchos con lugar para el título más los íconos de orden y filtro: con 90px
                   el encabezado quedaba recortado a nada. En columnas fijas se agranda Width
                   y no MinWidth: los offsets sticky se calculan con el Width declarado. *@
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="TipoDev" Title="Tipo Dev" Width="140px" Frozen="true" Pickable="false" />
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="NroDev" Title="Nro Dev" Width="130px" Frozen="true" Pickable="false" TextAlign="TextAlign.Right" />
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="Expediente" Title="Expediente" Width="180px" Frozen="true" Pickable="false" />
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="Empresa" Title="Empresa" Width="200px" Frozen="true" Pickable="false" />
                @* El tablero agrupa las líneas del devengado; en Pagos se ven separadas.
                   El badge avisa cuántas resume esta fila y de cuál salen los datos. *@
                @* 200px y no 150px: tienen que entrar el importe (hasta decenas de millones)
                   y el badge de líneas, que no puede encogerse (flex-shrink: 0) porque el
                   flex lo recortaba a la mitad del texto. *@
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="ImporteTotal" Title="Importe" Width="200px" FormatString="{0:N2}" Frozen="true" Pickable="false" TextAlign="TextAlign.Right">
                    <Template Context="item">
                        @* Badge a la izquierda y número contra el borde derecho: los importes
                           quedan alineados entre filas (con o sin badge) y se comparan a ojo. *@
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.4rem" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End">
                            @if (item.CantidadLineas > 1)
                            {
                                @* Botón: clic (o Enter) abre el detalle completo en un diálogo,
                                   accesible por teclado; el hover queda como vista rápida. *@
                                <button type="button" class="saf-boton-badge"
                                        aria-label="@($"Ver las {item.CantidadLineas} líneas del devengado {item.TipoDev} {item.NroDev}")"
                                        @onclick="@(() => VerLineas(item))" @onclick:stopPropagation="true">
                                    <RadzenBadge BadgeStyle="BadgeStyle.Light"
                                                 Text="@($"{item.CantidadLineas} líneas")"
                                                 Style="white-space: nowrap;"
                                                 MouseEnter="@(el => MostrarLineas(el, item))"
                                                 MouseLeave="@(_ => TooltipService.Close())" />
                                </button>
                            }
                            <span>@item.ImporteTotal?.ToString("N2")</span>
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="StatusDgayfNombre" Title="Status DGAyF" Width="150px" />
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="FirmadaPorMiguel" Title="Firmada por Miguel?" Width="200px" />
                @* El aviso de atraso como columna: su filtro nativo (checkboxes) lista
                   Pedido 2 / Pedido 3 / vacío — el resaltado naranja solo señala la celda. *@
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="Atraso" Title="Atraso" Width="150px" Sortable="true">
                    <Template Context="item">
                        @if (item.Atraso is string atraso)
                        {
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.3rem" AlignItems="AlignItems.Center"
                                         title="Más de 7 días sin ingreso de factura: corresponde el siguiente pedido.">
                                <RadzenIcon Icon="warning" Style="color: var(--rz-warning); font-size: 1.1rem;" />
                                <span>@atraso</span>
                            </RadzenStack>
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="FechaPedidoFactura1" Title="Fecha Ped. Factura 1" Width="165px" FormatString="{0:dd/MM/yyyy}" />
                @* Columnas de Cuentas a Pagar: en edición, quien no es del área ve el valor
                   como texto (el editor no se renderiza, así el guardado no puede tocarlas). *@
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="FechaPedidoFactura2" Title="Fecha Ped. Factura 2" Width="165px" FormatString="{0:dd/MM/yyyy}">
                    <EditTemplate Context="item">
                        @if (_editaCuentasPagar)
                        {
                            <RadzenDatePicker @bind-Value="Buffer(item).FechaPedidoFactura2" DateFormat="dd/MM/yyyy" Style="width:100%" />
                        }
                        else
                        {
                            <span>@item.FechaPedidoFactura2?.ToString("dd/MM/yyyy")</span>
                        }
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="ReiterarPedidoFactura3" Title="Reit. Ped. Factura 3" Width="165px" FormatString="{0:dd/MM/yyyy}">
                    <EditTemplate Context="item">
                        @if (_editaCuentasPagar)
                        {
                            <RadzenDatePicker @bind-Value="Buffer(item).ReiterarPedidoFactura3" DateFormat="dd/MM/yyyy" Style="width:100%" />
                        }
                        else
                        {
                            <span>@item.ReiterarPedidoFactura3?.ToString("dd/MM/yyyy")</span>
                        }
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="FechaRechazo" Title="Fecha de Rechazo" Width="165px" FormatString="{0:dd/MM/yyyy}">
                    <EditTemplate Context="item">
                        @if (_editaCuentasPagar)
                        {
                            <RadzenDatePicker @bind-Value="Buffer(item).FechaRechazo" DateFormat="dd/MM/yyyy" AllowClear="true" Style="width:100%" />
                        }
                        else
                        {
                            <span>@item.FechaRechazo?.ToString("dd/MM/yyyy")</span>
                        }
                    </EditTemplate>
                </RadzenDataGridColumn>
                @* Col K del tablero: fecha, o marca "Sin factura" (N/C · CCOO · PAV · Anulado) cuando no hay fecha *@
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="FechaIngresoFactura" Title="Ingreso Factura" Width="145px">
                    <Template Context="item">
                        @(item.FechaIngresoFactura?.ToString("dd/MM/yyyy") ?? item.SinFacturaMotivo)
                    </Template>
                    <EditTemplate Context="item">
                        @if (_editaCuentasPagar)
                        {
                            <RadzenStack Gap="0.25rem">
                                <RadzenDatePicker @bind-Value="Buffer(item).FechaIngresoFactura" DateFormat="dd/MM/yyyy" AllowClear="true" Style="width:100%" />
                                <RadzenDropDown @bind-Value="Buffer(item).SinFacturaMotivo"
                                                Data="@_sinFacturaMotivos"
                                                AllowClear="true"
                                                Placeholder="Sin factura..."
                                                Style="width:100%" />
                            </RadzenStack>
                        }
                        else
                        {
                            <span>@(item.FechaIngresoFactura?.ToString("dd/MM/yyyy") ?? item.SinFacturaMotivo)</span>
                        }
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="StatusContableNombre" Title="Status Contable" Width="150px">
                    <EditTemplate Context="item">
                        <RadzenDropDown @bind-Value="Buffer(item).StatusContableOpcionId"
                                        Data="@_statusContableOpciones"
                                        TextProperty="Nombre"
                                        ValueProperty="Id"
                                        AllowClear="true"
                                        Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="ObservacionesCuentasPagar" Title="Obs. Ctas. a Pagar" Width="200px">
                    <EditTemplate Context="item">
                        @if (_editaCuentasPagar)
                        {
                            <RadzenTextArea @bind-Value="Buffer(item).ObservacionesCuentasPagar" Style="width:100%" Rows="2" />
                        }
                        else
                        {
                            <span>@item.ObservacionesCuentasPagar</span>
                        }
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="TramitadorCuentasPagarNombre" Title="Tramitador Ctas. Pagar" Width="190px">
                    <EditTemplate Context="item">
                        @if (_editaCuentasPagar)
                        {
                            <RadzenDropDown @bind-Value="Buffer(item).TramitadorCuentasPagarOpcionId"
                                            Data="@_tramitadoresCuentasPagar"
                                            TextProperty="Nombre"
                                            ValueProperty="Id"
                                            AllowClear="true"
                                            Style="width:100%" />
                        }
                        else
                        {
                            <span>@item.TramitadorCuentasPagarNombre</span>
                        }
                    </EditTemplate>
                </RadzenDataGridColumn>
                @* Columnas de Liquidaciones: mismo criterio, con su propia área. *@
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="TramitadorLiquidacionesNombre" Title="Tramitador Liquidaciones" Width="200px">
                    <EditTemplate Context="item">
                        @if (_editaLiquidaciones)
                        {
                            <RadzenDropDown @bind-Value="Buffer(item).TramitadorLiquidacionesOpcionId"
                                            Data="@_tramitadoresLiquidaciones"
                                            TextProperty="Nombre"
                                            ValueProperty="Id"
                                            AllowClear="true"
                                            Style="width:100%" />
                        }
                        else
                        {
                            <span>@item.TramitadorLiquidacionesNombre</span>
                        }
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="ObservacionesLiquidaciones" Title="Obs. Liquidaciones" Width="200px">
                    <EditTemplate Context="item">
                        @if (_editaLiquidaciones)
                        {
                            <RadzenTextArea @bind-Value="Buffer(item).ObservacionesLiquidaciones" Style="width:100%" Rows="2" />
                        }
                        else
                        {
                            <span>@item.ObservacionesLiquidaciones</span>
                        }
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="EeSade" Title="EE SADE" Width="250px" />
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="Observaciones" Title="Observaciones" Width="200px" />
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="Ccoo" Title="CCOO" Width="150px" />
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="FechaCcoo" Title="Fecha CCOO" Width="150px" FormatString="{0:dd/MM/yyyy}" />
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="FechaNotificacion" Title="Fecha Notificación" Width="170px" FormatString="{0:dd/MM/yyyy}" />
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="BuzonSade" Title="Buzón SADE" Width="140px" />
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="UltimoMovimientoSade" Title="Último Movimiento" Width="180px" FormatString="{0:dd/MM/yyyy HH:mm}" />
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="DiasEnElArea" Title="Días en el Área" Width="155px" TextAlign="TextAlign.Right" />
                @if (CanEdit)
                {
                    @* 200px: tres botones de acción (editar, ventana, historial). *@
                    <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Title="Acciones" Width="200px" Frozen="true" FrozenPosition="FrozenColumnPosition.Right" Pickable="false" Filterable="false" Sortable="false">
                        @* Sin eliminar: las filas del tablero nacen del ledger de devengados. *@
                        <Template Context="item">
                            <AccionesFila MostrarEditar="true"
                                          OnEditar="@(() => _grid.EditRow(item))"
                                          OnEditarEnVentana="@(() => EditarEnVentana(item))"
                                          OnHistorial="@(() => VerHistorial(item))" />
                        </Template>
                        <EditTemplate Context="item">
                            <AccionesFila Edicion="true"
                                          OnGuardar="@(() => GuardarFila(item))"
                                          OnCancelar="@(() => CancelEdit(item))" />
                        </EditTemplate>
                    </RadzenDataGridColumn>
                }
            </Columns>
            <FooterTemplate>
                @* View y no _items: es lo que queda a la vista con los filtros aplicados.
                   Sin las marcas de carga parcial: acá las filas (y sus importes) llegan
                   completas de entrada, el segundo plano solo rellena columnas SADE/IVC. *@
                <GridFooterTotales Filas="@(_grid?.View?.Count() ?? 0)"
                                   TotalFilas="@_items.Count"
                                   Importe="@(_grid?.View?.Sum(x => x.ImporteTotal ?? 0m) ?? 0m)" />
            </FooterTemplate>
        </RadzenDataGrid>
    }
</RadzenStack>

@code {
    // El tooltip es hover-only (salir del badge lo cierra: no se puede scrollear); un
    // devengado suele tener 2-4 líneas, pero el tope evita salirse de pantalla si no.
    private const int MaxLineasTooltip = 10;

    // Detalle de las líneas que resume la fila, armado con componentes de Radzen.
    // Duration null: el tooltip se cierra al salir del badge (MouseLeave).
    private void MostrarLineas(ElementReference badge, SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel item)
    {
        // Anchos fijos para que las columnas queden alineadas a la izquierda entre filas
        // (sin Size, la grilla de Radzen las estira y reparte todo el ancho).
        var columnas = Math.Max(1, item.DetalleLineas.Columnas.Count);
        var ancho = Math.Max(1, Math.Min(6, 10 / columnas));

        TooltipService.Open(badge, _ =>
            @* Sin RadzenText: sus clases de tipografía fijan el color del tema (oscuro) y
               pisan el del tooltip. Con marcado simple el texto hereda el blanco. *@
            @<RadzenStack Gap="0.5rem">
                <strong>@item.CantidadLineas líneas en Pagos · devengado @item.TipoDev @item.NroDev</strong>

                @if (item.DetalleLineas.SinDiferencias)
                {
                    <span>Las líneas traen los mismos datos; el tablero suma los importes.</span>
                }
                else
                {
                    <RadzenRow Gap="1rem">
                        @foreach (var columna in item.DetalleLineas.Columnas)
                        {
                            <RadzenColumn Size="@ancho" class="rz-text-nowrap"><strong>@columna</strong></RadzenColumn>
                        }
                    </RadzenRow>

                    @foreach (var linea in item.DetalleLineas.Filas.Take(MaxLineasTooltip))
                    {
                        <RadzenRow Gap="1rem" AlignItems="AlignItems.Center">
                            @foreach (var valor in linea.Valores.SkipLast(1))
                            {
                                <RadzenColumn Size="@ancho" class="rz-text-nowrap"><span>@valor</span></RadzenColumn>
                            }
                            @* La marca va dentro de la última columna, contra su borde
                               derecho: así termina donde termina la columna. *@
                            <RadzenColumn Size="@ancho" class="rz-text-nowrap">
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem"
                                             AlignItems="AlignItems.Center"
                                             JustifyContent="JustifyContent.SpaceBetween">
                                    <span>@linea.Valores.Last()</span>
                                    @if (linea.EsPrincipal)
                                    {
                                        @* Primary: sobre el fondo claro, el badge claro no se distinguía. *@
                                        <RadzenBadge BadgeStyle="BadgeStyle.Primary" Text="principal"
                                                     class="saf-badge-compacto" />
                                    }
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>
                    }

                    @if (item.DetalleLineas.Filas.Count > MaxLineasTooltip)
                    {
                        <span>… y @(item.DetalleLineas.Filas.Count - MaxLineasTooltip) líneas más. Hacé clic en la marca para ver el detalle completo.</span>
                    }
                }

                <small>
                    Solo se listan los datos que difieren. De la línea principal salen el
                    expediente, la empresa y los datos cargados; el importe es la suma.
                </small>
            </RadzenStack>
        , new TooltipOptions
        {
            Position = TooltipPosition.Left,
            Duration = null,
            // La receta del fondo vive en el token (tokens.css); inline para ganarle
            // al fondo propio del tooltip de Radzen.
            Style = "background: var(--saf-tooltip-detalle-bg); color: var(--rz-text-color);",
        });
    }

    // Detalle completo en diálogo: todas las líneas, accesible por teclado, scrolleable
    // y copiable — el tooltip de hover es solo la vista rápida (y trunca a 10).
    private async Task VerLineas(SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel item)
    {
        TooltipService.Close();

        await DialogService.OpenAsync($"Líneas en Pagos — Devengado {item.TipoDev} {item.NroDev}", _ =>
            @<RadzenStack Gap="0.75rem">
                @if (item.DetalleLineas.SinDiferencias)
                {
                    <span>
                        Las @item.CantidadLineas líneas traen los mismos datos; el tablero
                        suma los importes.
                    </span>
                }
                else
                {
                    <table class="saf-tabla-detalle">
                        <thead>
                            <tr>
                                @foreach (var columna in item.DetalleLineas.Columnas)
                                {
                                    <th>@columna</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var linea in item.DetalleLineas.Filas)
                            {
                                <tr>
                                    @for (var i = 0; i < linea.Valores.Count; i++)
                                    {
                                        <td>
                                            @linea.Valores[i]
                                            @if (linea.EsPrincipal && i == linea.Valores.Count - 1)
                                            {
                                                <RadzenBadge BadgeStyle="BadgeStyle.Primary" Text="principal"
                                                             class="saf-badge-compacto" Style="margin-left: 0.5rem;" />
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                <small>
                    Solo se listan los datos que difieren. De la línea principal salen el
                    expediente, la empresa y los datos cargados; el importe es la suma.
                </small>
            </RadzenStack>
        , new DialogOptions { Width = "640px" });
    }
}
