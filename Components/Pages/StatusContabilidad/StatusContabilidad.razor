@page "/status-contabilidad"
@inherits SAF.Components.GridPageBase<SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel>

<PageTitle>Status Contabilidad</PageTitle>

<RadzenStack>
    <GridToolbar Titulo="Status Contabilidad"
                 CargandoResto="@_cargandoResto"
                 TextoCargando="Completando datos de SADE…"
                 Exportando="@_exportando"
                 ExportarDeshabilitado="@ExportarDeshabilitado"
                 OnExportar="@ExportarExcel" />

    @if (_loading)
    {
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    }
    else
    {
        @* Virtualización en lugar de paginado: scroll continuo (como la planilla)
           renderizando solo las filas visibles. Requiere el alto fijo del Style. *@
        <RadzenDataGrid @ref="_grid"
                        Data="@_items"
                        TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel"
                        AllowFiltering="true"
                        AllowSorting="true"
                        AllowColumnResize="true"
                        AllowColumnPicking="true"
                        ColumnsText="Columnas"
                        AllColumnsText="Todas"
                        ColumnsShowingText="columnas mostradas"
                        FilterMode="FilterMode.CheckBoxList"
                        ClearFilterText="Limpiar"
                        ApplyFilterText="Aplicar"
                        AllowPaging="false"
                        AllowVirtualization="true"
                        Style="height: calc(100vh - 15rem)"
                        EditMode="DataGridEditMode.Single"
                        RowEdit="@OnRowEdit"
                        RowUpdate="@OnRowUpdate">
            <Columns>
                @* Las columnas hasta Importe quedan fijas al scrollear horizontalmente y
                   fuera del selector de columnas: identifican la fila, no pueden faltar. *@
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="TipoDev" Title="Tipo Dev" Width="90px" Frozen="true" Pickable="false" />
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="NroDev" Title="Nro Dev" Width="90px" Frozen="true" Pickable="false" />
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="Expediente" Title="Expediente" Width="150px" Frozen="true" Pickable="false" />
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="Empresa" Title="Empresa" Width="200px" Frozen="true" Pickable="false" />
                @* El tablero agrupa las líneas del devengado; en Pagos se ven separadas.
                   El badge avisa cuántas resume esta fila y de cuál salen los datos. *@
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="ImporteTotal" Title="Importe" Width="150px" FormatString="{0:N2}" Frozen="true" Pickable="false">
                    <Template Context="item">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.4rem" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                            <span>@item.ImporteTotal?.ToString("N2")</span>
                            @if (item.CantidadLineas > 1)
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Light"
                                             Text="@($"{item.CantidadLineas} líneas")"
                                             Style="cursor: help;"
                                             MouseEnter="@(el => MostrarLineas(el, item))"
                                             MouseLeave="@(_ => TooltipService.Close())" />
                            }
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="StatusDgayfNombre" Title="Status DGAyF" Width="150px" />
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="FirmadaPorMiguel" Title="Firmada por Miguel?" Width="160px" />
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="FechaPedidoFactura1" Title="Fecha Ped. Factura 1" Width="165px" FormatString="{0:dd/MM/yyyy}" />
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="FechaPedidoFactura2" Title="Fecha Ped. Factura 2" Width="165px" FormatString="{0:dd/MM/yyyy}">
                    <EditTemplate Context="item">
                        <RadzenDatePicker @bind-Value="item.FechaPedidoFactura2" DateFormat="dd/MM/yyyy" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="ReiterarPedidoFactura3" Title="Reit. Ped. Factura 3" Width="165px" FormatString="{0:dd/MM/yyyy}">
                    <EditTemplate Context="item">
                        <RadzenDatePicker @bind-Value="item.ReiterarPedidoFactura3" DateFormat="dd/MM/yyyy" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="FechaRechazo" Title="Fecha de Rechazo" Width="145px" FormatString="{0:dd/MM/yyyy}">
                    <EditTemplate Context="item">
                        <RadzenDatePicker @bind-Value="item.FechaRechazo" DateFormat="dd/MM/yyyy" AllowClear="true" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                @* Col K del tablero: fecha, o marca "Sin factura" (N/C · CCOO · PAV · Anulado) cuando no hay fecha *@
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="FechaIngresoFactura" Title="Ingreso Factura" Width="145px">
                    <Template Context="item">
                        @(item.FechaIngresoFactura?.ToString("dd/MM/yyyy") ?? item.SinFacturaMotivo)
                    </Template>
                    <EditTemplate Context="item">
                        <RadzenStack Gap="0.25rem">
                            <RadzenDatePicker @bind-Value="item.FechaIngresoFactura" DateFormat="dd/MM/yyyy" AllowClear="true" Style="width:100%" />
                            <RadzenDropDown @bind-Value="item.SinFacturaMotivo"
                                            Data="@_sinFacturaMotivos"
                                            AllowClear="true"
                                            Placeholder="Sin factura..."
                                            Style="width:100%" />
                        </RadzenStack>
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="StatusContableNombre" Title="Status Contable" Width="150px">
                    <EditTemplate Context="item">
                        <RadzenDropDown @bind-Value="item.StatusContableOpcionId"
                                        Data="@_statusContableOpciones"
                                        TextProperty="Nombre"
                                        ValueProperty="Id"
                                        AllowClear="true"
                                        Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="ObservacionesCuentasPagar" Title="Obs. Ctas. a Pagar" Width="200px">
                    <EditTemplate Context="item">
                        <RadzenTextArea @bind-Value="item.ObservacionesCuentasPagar" Style="width:100%" Rows="2" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="TramitadorCuentasPagarNombre" Title="Tramitador Ctas. Pagar" Width="190px">
                    <EditTemplate Context="item">
                        <RadzenDropDown @bind-Value="item.TramitadorCuentasPagarOpcionId"
                                        Data="@_tramitadoresCuentasPagar"
                                        TextProperty="Nombre"
                                        ValueProperty="Id"
                                        AllowClear="true"
                                        Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="TramitadorLiquidacionesNombre" Title="Tramitador Liquidaciones" Width="200px">
                    <EditTemplate Context="item">
                        <RadzenDropDown @bind-Value="item.TramitadorLiquidacionesOpcionId"
                                        Data="@_tramitadoresLiquidaciones"
                                        TextProperty="Nombre"
                                        ValueProperty="Id"
                                        AllowClear="true"
                                        Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="ObservacionesLiquidaciones" Title="Obs. Liquidaciones" Width="200px">
                    <EditTemplate Context="item">
                        <RadzenTextArea @bind-Value="item.ObservacionesLiquidaciones" Style="width:100%" Rows="2" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="EeSade" Title="EE SADE" Width="250px" />
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="Observaciones" Title="Observaciones" Width="200px" />
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="Ccoo" Title="CCOO" Width="130px" />
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="FechaCcoo" Title="Fecha CCOO" Width="130px" FormatString="{0:dd/MM/yyyy}" />
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="FechaNotificacion" Title="Fecha Notificación" Width="155px" FormatString="{0:dd/MM/yyyy}" />
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="BuzonSade" Title="Buzón SADE" Width="140px" />
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="UltimoMovimientoSade" Title="Último Movimiento" Width="160px" FormatString="{0:dd/MM/yyyy HH:mm}" />
                <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Property="DiasEnElArea" Title="Días en el Área" Width="130px" />
                @if (CanEdit)
                {
                    <RadzenDataGridColumn TItem="SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel" Title="Acciones" Width="120px" Frozen="true" FrozenPosition="FrozenColumnPosition.Right" Pickable="false">
                        <Template Context="item">
                            <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                          Click="@(() => _grid.EditRow(item))" />
                            <RadzenButton Icon="history" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                          Click="@(() => VerHistorial(item))" title="Historial de cambios" />
                        </Template>
                        <EditTemplate Context="item">
                            <RadzenButton Icon="save" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small"
                                          Click="@(() => GuardarFila(item))" />
                            <RadzenButton Icon="cancel" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                          Click="@(() => CancelEdit(item))" />
                        </EditTemplate>
                    </RadzenDataGridColumn>
                }
            </Columns>
            <FooterTemplate>
                @* View y no _items: es lo que queda a la vista con los filtros aplicados.
                   Sin las marcas de carga parcial: acá las filas (y sus importes) llegan
                   completas de entrada, el segundo plano solo rellena columnas SADE/IVC. *@
                <GridFooterTotales Filas="@(_grid?.View?.Count() ?? 0)"
                                   Importe="@(_grid?.View?.Sum(x => x.ImporteTotal ?? 0m) ?? 0m)" />
            </FooterTemplate>
        </RadzenDataGrid>
    }
</RadzenStack>

@code {
    // El tooltip es hover-only (salir del badge lo cierra: no se puede scrollear); un
    // devengado suele tener 2-4 líneas, pero el tope evita salirse de pantalla si no.
    private const int MaxLineasTooltip = 10;

    // Detalle de las líneas que resume la fila, armado con componentes de Radzen.
    // Duration null: el tooltip se cierra al salir del badge (MouseLeave).
    private void MostrarLineas(ElementReference badge, SAF.Application.StatusContabilidad.Dtos.StatusContabilidadViewModel item)
    {
        // Anchos fijos para que las columnas queden alineadas a la izquierda entre filas
        // (sin Size, la grilla de Radzen las estira y reparte todo el ancho).
        var columnas = Math.Max(1, item.DetalleLineas.Columnas.Count);
        var ancho = Math.Max(1, Math.Min(6, 10 / columnas));

        TooltipService.Open(badge, _ =>
            @* Sin RadzenText: sus clases de tipografía fijan el color del tema (oscuro) y
               pisan el del tooltip. Con marcado simple el texto hereda el blanco. *@
            @<RadzenStack Gap="0.5rem">
                <strong>@item.CantidadLineas líneas en Pagos · devengado @item.TipoDev @item.NroDev</strong>

                @if (item.DetalleLineas.SinDiferencias)
                {
                    <span>Las líneas traen los mismos datos; el tablero suma los importes.</span>
                }
                else
                {
                    <RadzenRow Gap="1rem">
                        @foreach (var columna in item.DetalleLineas.Columnas)
                        {
                            <RadzenColumn Size="@ancho" class="rz-text-nowrap"><strong>@columna</strong></RadzenColumn>
                        }
                    </RadzenRow>

                    @foreach (var linea in item.DetalleLineas.Filas.Take(MaxLineasTooltip))
                    {
                        <RadzenRow Gap="1rem" AlignItems="AlignItems.Center">
                            @foreach (var valor in linea.Valores.SkipLast(1))
                            {
                                <RadzenColumn Size="@ancho" class="rz-text-nowrap"><span>@valor</span></RadzenColumn>
                            }
                            @* La marca va dentro de la última columna, contra su borde
                               derecho: así termina donde termina la columna. *@
                            <RadzenColumn Size="@ancho" class="rz-text-nowrap">
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem"
                                             AlignItems="AlignItems.Center"
                                             JustifyContent="JustifyContent.SpaceBetween">
                                    <span>@linea.Valores.Last()</span>
                                    @if (linea.EsPrincipal)
                                    {
                                        @* Primary: sobre el fondo claro, el badge claro no se distinguía. *@
                                        <RadzenBadge BadgeStyle="BadgeStyle.Primary" Text="principal"
                                                     Style="--rz-badge-font-size: 0.65rem; --rz-badge-padding: 0.05rem 0.35rem;" />
                                    }
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>
                    }

                    @if (item.DetalleLineas.Filas.Count > MaxLineasTooltip)
                    {
                        <span>… y @(item.DetalleLineas.Filas.Count - MaxLineasTooltip) líneas más.</span>
                    }
                }

                <small>
                    Solo se listan los datos que difieren. De la línea principal salen el
                    expediente, la empresa y los datos cargados; el importe es la suma.
                </small>
            </RadzenStack>
        , new TooltipOptions
        {
            Position = TooltipPosition.Left,
            Duration = null,
            // Mismo fondo que el ítem de menú seleccionado (--rz-primary-lighter). Ese
            // token es translúcido: sobre el sidebar apoya en su superficie, pero el
            // tooltip flota sobre la grilla, así que se compone sobre la superficie base.
            Style = "background: linear-gradient(var(--rz-primary-lighter), var(--rz-primary-lighter)), " +
                    "var(--rz-base-background-color); color: var(--rz-text-color);",
        });
    }
}
