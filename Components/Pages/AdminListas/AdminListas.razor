@page "/admin/listas"
@using SAF.Application.AdminListas
@using SAF.Application.AdminListas.Dtos
@inherits SAF.Components.GridPageBase<SAF.Application.AdminListas.Dtos.OpcionListaViewModel>

<PageTitle>Administración de listas</PageTitle>

<RadzenStack>
    @* El selector define QUÉ lista muestra la página: va junto al título (donde el
       usuario empieza a leer), no mezclado con las acciones. Reparto 7/5: el título
       más el dropdown necesitan el ancho; las acciones acá son solo Nuevo y Exportar. *@
    <GridToolbar Titulo="Administración de listas"
                 SizeTitulo="7"
                 SizeAcciones="5"
                 MostrarNuevo="@CanCreate"
                 NuevoDeshabilitado="@_loading"
                 OnNuevo="@AddRow"
                 LimpiarFiltrosDeshabilitado="@(!HayFiltrosActivos)"
                 Exportando="@_exportando"
                 ExportarDeshabilitado="@ExportarDeshabilitado"
                 TituloExportarDeshabilitado="@MotivoExportarDeshabilitado"
                 OnExportar="@ExportarExcel"
                 OnLimpiarFiltros="@LimpiarFiltros">
        <Contexto>
            <RadzenLabel Text="Lista:" Component="ListaSeleccionada" />
            <RadzenDropDown TValue="ListaAdminDefinicion"
                            Name="ListaSeleccionada"
                            Data="@_listasVisibles"
                            @bind-Value="_lista"
                            TextProperty="Titulo"
                            Change="@OnListaChanged"
                            Disabled="@_loading"
                            Style="min-width: 260px" />
        </Contexto>
    </GridToolbar>

    @if (_loading)
    {
        <EstadoCarga Texto="@($"Cargando {TituloEntidad}…")" />
    }
    else if (_listasVisibles.Count == 0)
    {
        <RadzenText>No tenés listas para administrar: requiere permiso de edición en alguna de las vistas.</RadzenText>
    }
    else
    {
        @* Listas cortas (≤ ~25 filas): grilla completa sin paginado ni virtualización. *@
        <RadzenDataGrid @ref="_grid"
                        Data="@_items"
                        TItem="OpcionListaViewModel"
                        Filter="@OnGridFilter"
                        FilterCleared="@OnGridFilter"
                        AllowFiltering="true"
                        AllowSorting="true"
                        AllowColumnResize="true"
                        FilterMode="FilterMode.CheckBoxList"
                        ClearFilterText="Limpiar"
                        ApplyFilterText="Aplicar"
                        EmptyText="No hay filas para mostrar. Si aplicaste filtros, podés quitarlos con el botón de la barra superior."
                        AllowPaging="false"
                        EditMode="DataGridEditMode.Single"
                        RowEdit="@OnRowEdit"
                        RowUpdate="@OnRowUpdate"
                        RowCreate="@OnRowCreate">
            <Columns>
                <RadzenDataGridColumn TItem="OpcionListaViewModel" Property="Nombre" Title="Nombre">
                    <EditTemplate Context="item">
                        <RadzenTextBox @bind-Value="Buffer(item).Nombre" MaxLength="@OpcionListaValidator.NombreMaxLength" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="OpcionListaViewModel" Property="Orden" Title="Orden" Width="135px" TextAlign="TextAlign.Right">
                    <EditTemplate Context="item">
                        <RadzenNumeric TValue="int" @bind-Value="Buffer(item).Orden" Min="0" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="OpcionListaViewModel" Property="Activo" Title="Activo" Width="150px">
                    <Template Context="item">@(item.Activo ? "Sí" : "No")</Template>
                    <EditTemplate Context="item">
                        <RadzenCheckBox TValue="bool" @bind-Value="Buffer(item).Activo" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                @if (_lista.TieneEsOk)
                {
                    @* Solo Seguros: si la opción cuenta como "seguro en regla" en el cruce a Pagos. *@
                    <RadzenDataGridColumn TItem="OpcionListaViewModel" Property="EsOk" Title="Cuenta como OK" Width="165px">
                        <Template Context="item">@(item.EsOk == true ? "Sí" : "No")</Template>
                        <EditTemplate Context="item">
                            <RadzenCheckBox TValue="bool?" TriState="false" @bind-Value="Buffer(item).EsOk" />
                        </EditTemplate>
                    </RadzenDataGridColumn>
                }
                @if (CanEdit || CanDelete || CanCreate)
                {
                    <RadzenDataGridColumn TItem="OpcionListaViewModel" Title="Acciones" Width="150px" Frozen="true" FrozenPosition="FrozenColumnPosition.Right" Filterable="false" Sortable="false">
                        <Template Context="item">
                            @if (CanEdit)
                            {
                                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                              Click="@(() => _grid.EditRow(item))" title="Editar fila" />
                            }
                            @if (CanDelete)
                            {
                                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                              Click="@(() => DeleteRow(item))" title="Eliminar fila" />
                            }
                            <RadzenButton Icon="history" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                          Click="@(() => VerHistorial(item))" title="Historial de cambios" />
                        </Template>
                        <EditTemplate Context="item">
                            <RadzenButton Icon="save" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small"
                                          Click="@(() => GuardarFila(item))" title="Guardar cambios" />
                            <RadzenButton Icon="cancel" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                          Click="@(() => CancelEdit(item))" title="Cancelar edición" />
                        </EditTemplate>
                    </RadzenDataGridColumn>
                }
            </Columns>
        </RadzenDataGrid>
    }
</RadzenStack>
