@page "/pagos"
@inherits SAF.Components.GridPageBase<SAF.Application.Pagos.Dtos.PagoViewModel>

<PageTitle>Pagos</PageTitle>

<RadzenStack>
    @* La barra de Pagos lleva un botón más que las otras vistas (Sincronizar): sin
       repartir el ancho, los botones quedan apretados y el texto se parte. *@
    <GridToolbar Titulo="Pagos"
                 SizeTitulo="3"
                 SizeAcciones="9"
                 OnBuscar="@OnBusquedaChanged"
                 TextoBusqueda="@_textoBusqueda"
                 PlaceholderBusqueda="Buscar devengado, expediente o empresa…"
                 LimpiarFiltrosDeshabilitado="@(!HayFiltrosActivos)"
                 CargandoResto="@_cargandoResto"
                 Exportando="@_exportando"
                 ExportarDeshabilitado="@ExportarDeshabilitado"
                 TituloExportarDeshabilitado="@MotivoExportarDeshabilitado"
                 OnExportar="@ExportarExcel"
                 OnLimpiarFiltros="@LimpiarFiltros">
        <Acciones>
            @if (CanCreate)
            {
                @* Alta en ventana y no inline: los 6 campos de identidad juntos y con
                   labels, en vez de repartidos por el ancho de la grilla. *@
                <RadzenButton Text="Nuevo"
                              Icon="add"
                              ButtonStyle="ButtonStyle.Primary"
                              Click="@NuevoEnVentana"
                              Disabled="@(_loading || _syncing)" />
                @* Light (gris): la acción principal de la vista es una sola (Nuevo);
                   dos primarios compiten y ninguno destaca. La última actualización
                   va en el tooltip: es el dato que decide si vale la pena sincronizar. *@
                <RadzenButton Text="Sincronizar"
                              Icon="sync"
                              ButtonStyle="ButtonStyle.Light"
                              title="@($"Importa los devengados nuevos desde IVC. Última actualización: {_ultimaActualizacion?.ToString("dd/MM/yyyy") ?? "—"}")"
                              Click="@SincronizarDevengados"
                              IsBusy="@_syncing"
                              BusyText="Sincronizando..."
                              Disabled="@_syncing" />
            }
        </Acciones>
    </GridToolbar>

    @if (_loading)
    {
        <EstadoCarga Texto="@($"Cargando {TituloEntidad}…")" />
    }
    else
    {
        @* Virtualización en lugar de paginado: scroll continuo (como la planilla)
           renderizando solo las filas visibles. Requiere el alto fijo del Style. *@
        <RadzenDataGrid @ref="_grid"
                        Data="@ItemsVisibles"
                        TItem="SAF.Application.Pagos.Dtos.PagoViewModel"
                        Filter="@OnGridFilter"
                        FilterCleared="@OnGridFilter"
                        AllowFiltering="true"
                        AllowSorting="true"
                        AllowColumnResize="true"
                        FilterMode="FilterMode.CheckBoxList"
                        ClearFilterText="@GridTextos.LimpiarFiltro"
                        ApplyFilterText="@GridTextos.AplicarFiltro"
                        EmptyText="@GridTextos.Vacio"
                        AllowPaging="false"
                        AllowVirtualization="true"
                        Style="height: calc(100vh - 15rem)"
                        EditMode="DataGridEditMode.Single"
                        RowEdit="@OnRowEdit"
                        RowUpdate="@OnRowUpdate"
                        RowCreate="@OnRowCreate">
            <Columns>
                @* Campos IVC: solo editables en el alta manual (Id == 0); en edición quedan bloqueados. *@
                @* Como en Status Contabilidad, las columnas de identidad quedan fijas al
                   scrollear: identifican la fila, no pueden faltar. Fecha Devengado va
                   después del bloque fijo para que las congeladas sean contiguas (los
                   offsets sticky se calculan con el Width declarado). *@
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="TipoDev" Title="Tipo Dev" Width="140px" Frozen="true">
                    <EditTemplate Context="item">
                        <RadzenTextBox @bind-Value="Buffer(item).TipoDev" Disabled="@(item.Id != 0)" Placeholder="PRD" Style="width:100%"
                                       class="@GetValidationCssClass(item.Id != 0 || !string.IsNullOrWhiteSpace(Buffer(item).TipoDev))" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="NroDev" Title="Nro Dev" Width="130px" Frozen="true" TextAlign="TextAlign.Right">
                    <EditTemplate Context="item">
                        <RadzenNumeric TValue="int" @bind-Value="Buffer(item).NroDev" Disabled="@(item.Id != 0)" ShowUpDown="false" Style="width:100%"
                                       class="@GetValidationCssClass(item.Id != 0 || Buffer(item).NroDev > 0)" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="Expediente" Title="Expediente" Width="180px" Frozen="true">
                    <EditTemplate Context="item">
                        <ExpedienteEditor @bind-Value="Buffer(item).Expediente" Deshabilitado="@(item.Id != 0)" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="Empresa" Title="Empresa" Width="200px" Frozen="true">
                    <EditTemplate Context="item">
                        <RadzenTextBox @bind-Value="Buffer(item).Empresa" Disabled="@(item.Id != 0)" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="Importe" Title="Importe" Width="160px" FormatString="{0:N2}" Frozen="true" TextAlign="TextAlign.Right">
                    <EditTemplate Context="item">
                        <RadzenNumeric TValue="decimal?" @bind-Value="Buffer(item).Importe" Disabled="@(item.Id != 0)" ShowUpDown="false" Style="width:100%"
                                       class="@GetValidationCssClass(item.Id != 0 || Buffer(item).Importe is > 0)" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="FechaDevengado" Title="Fecha Devengado" Width="180px" FormatString="{0:dd/MM/yyyy}">
                    <EditTemplate Context="item">
                        <RadzenDatePicker @bind-Value="Buffer(item).FechaDevengado" Disabled="@(item.Id != 0)" DateFormat="dd/MM/yyyy" Style="width:100%"
                                          class="@GetValidationCssClass(item.Id != 0 || Buffer(item).FechaDevengado is not null)" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="StatusDgayfNombre" Title="Status DGAyF" Width="150px">
                    <EditTemplate Context="item">
                        <RadzenDropDown @bind-Value="Buffer(item).StatusDgayfOpcionId"
                                        Data="@_statusDgayfOpciones"
                                        TextProperty="Nombre"
                                        ValueProperty="Id"
                                        AllowClear="true"
                                        Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="StatusOpNombre" Title="Status OP" Width="150px">
                    <EditTemplate Context="item">
                        <RadzenDropDown @bind-Value="Buffer(item).StatusOpOpcionId"
                                        Data="@_statusOpOpciones"
                                        TextProperty="Nombre"
                                        ValueProperty="Id"
                                        AllowClear="true"
                                        Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="FechaFirmaOp" Title="Fecha Firma OP" Width="170px" FormatString="{0:dd/MM/yyyy}">
                    <EditTemplate Context="item">
                        <RadzenDatePicker @bind-Value="Buffer(item).FechaFirmaOp" DateFormat="dd/MM/yyyy" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="Observaciones" Title="Observaciones" Width="200px">
                    <EditTemplate Context="item">
                        <RadzenTextArea @bind-Value="Buffer(item).Observaciones" Style="width:100%" Rows="2" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="Ccoo" Title="CCOO" Width="150px">
                    <EditTemplate Context="item">
                        <RadzenTextBox @bind-Value="Buffer(item).Ccoo" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="FechaCcoo" Title="Fecha CCOO" Width="140px" FormatString="{0:dd/MM/yyyy}">
                    <EditTemplate Context="item">
                        <RadzenDatePicker @bind-Value="Buffer(item).FechaCcoo" DateFormat="dd/MM/yyyy" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="FechaNotificacion" Title="Fecha Notificación" Width="170px" FormatString="{0:dd/MM/yyyy}">
                    <EditTemplate Context="item">
                        <RadzenDatePicker @bind-Value="Buffer(item).FechaNotificacion" DateFormat="dd/MM/yyyy" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                @* Columnas calculadas/fórmula (a implementar luego): por ahora solo lectura *@
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="StatusContable" Title="Status Contable" Width="150px" />
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="SegurosTeso" Title="Seguros Teso" Width="150px" />
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="FechaDePagoNoCaf" Title="Fecha Pago No CAF" Width="180px" FormatString="{0:dd/MM/yyyy}" />
                @* Sin fecha puede significar "no se pagó nada" o "se pagó parte": el badge
                   distingue los dos casos, que antes se veían igual (o peor: como pagado). *@
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="FechaDePagoCaf" Title="Fecha Pago CAF" Width="165px" FormatString="{0:dd/MM/yyyy}">
                    <Template Context="item">
                        @* El badge es un botón: clic (o Enter) abre el detalle completo en un
                           diálogo, accesible por teclado y scrolleable; el hover queda como
                           vista rápida. *@
                        @if (item.CafPagoIncompleto)
                        {
                            <button type="button" class="saf-boton-badge"
                                    aria-label="@($"Ver las {item.CafOps} OP del expediente {item.Expediente}")"
                                    @onclick="@(() => VerOpsCaf(item))" @onclick:stopPropagation="true">
                                <RadzenBadge BadgeStyle="BadgeStyle.Warning"
                                             Text="@($"{item.CafOpsPagadas} de {item.CafOps} OP pagadas")"
                                             class="saf-badge-compacto"
                                             MouseEnter="@(el => MostrarOpsCaf(el, item))"
                                             MouseLeave="@(_ => TooltipService.Close())" />
                            </button>
                        }
                        else
                        {
                            @item.FechaDePagoCaf?.ToString("dd/MM/yyyy")

                            @* Con una sola OP la fecha se explica sola; con varias, el detalle. *@
                            @if (item.CafOps > 1)
                            {
                                <button type="button" class="saf-boton-badge"
                                        aria-label="@($"Ver las {item.CafOps} OP del expediente {item.Expediente}")"
                                        @onclick="@(() => VerOpsCaf(item))" @onclick:stopPropagation="true">
                                    <RadzenBadge BadgeStyle="BadgeStyle.Light"
                                                 Text="@($"{item.CafOps} OP")"
                                                 class="saf-badge-compacto"
                                                 MouseEnter="@(el => MostrarOpsCaf(el, item))"
                                                 MouseLeave="@(_ => TooltipService.Close())" />
                                </button>
                            }
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="FechaPagoTotal" Title="Fecha Pago Total" Width="170px" FormatString="{0:dd/MM/yyyy}" />
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="FechaSade" Title="Fecha SADE" Width="150px" FormatString="{0:dd/MM/yyyy}" />
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="BuzonSade" Title="Buzón SADE" Width="140px" />
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="PedidoFactura2" Title="Pedido Factura 2" Width="170px" FormatString="{0:dd/MM/yyyy}" />
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="PedidoFactura3" Title="Pedido Factura 3" Width="170px" FormatString="{0:dd/MM/yyyy}" />
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="FechaFacturaCorrecta" Title="Fecha Factura Correcta" Width="195px" FormatString="{0:dd/MM/yyyy}" />
                @* CAF SI/NO en standby: fuente PRESUPUESTO 2026 aún no implementada. Reactivar quitando Visible="false". *@
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="CafSiNo" Title="CAF" Width="125px" Visible="false">
                    <Template Context="item">
                        @(item.CafSiNo == true ? "Sí" : item.CafSiNo == false ? "No" : "")
                    </Template>
                </RadzenDataGridColumn>
                @if (CanEdit || CanDelete || CanCreate)
                {
                    @* 200px: hasta cuatro botones de acción (editar, ventana, eliminar, historial). *@
                    <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Title="Acciones" Width="200px" Frozen="true" FrozenPosition="FrozenColumnPosition.Right" Filterable="false" Sortable="false">
                        <Template Context="item">
                            <AccionesFila MostrarEditar="@CanEdit"
                                          MostrarEliminar="@CanDelete"
                                          OnEditar="@(() => _grid.EditRow(item))"
                                          OnEditarEnVentana="@(() => EditarEnVentana(item))"
                                          OnEliminar="@(() => DeleteRow(item))"
                                          OnHistorial="@(() => VerHistorial(item))" />
                        </Template>
                        <EditTemplate Context="item">
                            <AccionesFila Edicion="true"
                                          OnGuardar="@(() => GuardarFila(item))"
                                          OnCancelar="@(() => CancelEdit(item))" />
                        </EditTemplate>
                    </RadzenDataGridColumn>
                }
            </Columns>
            <FooterTemplate>
                @* View y no _items: es lo que queda a la vista con los filtros aplicados. *@
                <GridFooterTotales Filas="@(_grid?.View?.Count() ?? 0)"
                                   TotalFilas="@_items.Count"
                                   Importe="@(_grid?.View?.Sum(x => x.Importe ?? 0m) ?? 0m)"
                                   Cargando="@_cargandoResto"
                                   CargaIncompleta="@_cargaIncompleta" />
            </FooterTemplate>
        </RadzenDataGrid>
    }
</RadzenStack>

@code {
    // El tooltip es hover-only (salir del badge lo cierra: no se puede scrollear), así
    // que con muchas OPs se saldría de la pantalla; se listan las primeras y el resto
    // se resume. El detalle completo vive en la vista Expedientes CAF.
    private const int MaxLineasTooltip = 10;

    // Las OPs del expediente en CAF. Sin RadzenText: sus clases de tipografía fijan el
    // color del tema y pisan el del tooltip.
    private void MostrarOpsCaf(ElementReference origen, SAF.Application.Pagos.Dtos.PagoViewModel item)
        => TooltipService.Open(origen, _ =>
            @<RadzenStack Gap="0.5rem">
                <strong>Expediente @item.Expediente · @item.CafOpsPagadas de @item.CafOps OP pagadas</strong>

                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="4" class="rz-text-nowrap"><strong>OP</strong></RadzenColumn>
                    <RadzenColumn Size="4" class="rz-text-nowrap"><strong>Importe neto</strong></RadzenColumn>
                    <RadzenColumn Size="4" class="rz-text-nowrap"><strong>Fecha de pago</strong></RadzenColumn>
                </RadzenRow>

                @foreach (var linea in item.CafLineas.Take(MaxLineasTooltip))
                {
                    <RadzenRow Gap="1rem" AlignItems="AlignItems.Center">
                        <RadzenColumn Size="4" class="rz-text-nowrap"><span>@linea.Op</span></RadzenColumn>
                        <RadzenColumn Size="4" class="rz-text-nowrap"><span>@linea.ImporteNeto?.ToString("N2")</span></RadzenColumn>
                        <RadzenColumn Size="4" class="rz-text-nowrap">
                            <span>@(linea.FechaPago?.ToString("dd/MM/yyyy") ?? "-")</span>
                        </RadzenColumn>
                    </RadzenRow>
                }

                @if (item.CafLineas.Count > MaxLineasTooltip)
                {
                    <span>… y @(item.CafLineas.Count - MaxLineasTooltip) OP más. Hacé clic en la marca para ver el detalle completo.</span>
                }

                <small>
                    La fecha de pago CAF se informa solo cuando todas las OPs del expediente
                    están pagadas.
                </small>
            </RadzenStack>
        , new TooltipOptions
        {
            Position = TooltipPosition.Left,
            Duration = null,
            // La receta del fondo vive en el token (tokens.css); inline para ganarle
            // al fondo propio del tooltip de Radzen.
            Style = "background: var(--saf-tooltip-detalle-bg); color: var(--rz-text-color);",
        });

    // Detalle completo en diálogo: todas las OPs, accesible por teclado, scrolleable y
    // copiable — el tooltip de hover es solo la vista rápida (y trunca a 10).
    private async Task VerOpsCaf(SAF.Application.Pagos.Dtos.PagoViewModel item)
    {
        TooltipService.Close();

        await DialogService.OpenAsync($"OPs en CAF — Expediente {item.Expediente}", _ =>
            @<RadzenStack Gap="0.75rem">
                <strong>@item.CafOpsPagadas de @item.CafOps OP pagadas</strong>

                <table class="saf-tabla-detalle">
                    <thead>
                        <tr><th>OP</th><th>Importe neto</th><th>Fecha de pago</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var linea in item.CafLineas)
                        {
                            <tr>
                                <td>@linea.Op</td>
                                <td>@linea.ImporteNeto?.ToString("N2")</td>
                                <td>@(linea.FechaPago?.ToString("dd/MM/yyyy") ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <small>
                    La fecha de pago CAF se informa solo cuando todas las OPs del expediente
                    están pagadas.
                </small>
            </RadzenStack>
        , new DialogOptions { Width = "560px" });
    }
}
