@page "/pagos"
@inherits SAF.Components.GridPageBase<SAF.Application.Pagos.Dtos.PagoViewModel>

<PageTitle>Pagos</PageTitle>

<RadzenStack>
    @* La barra de Pagos lleva un botón más que las otras vistas (Sincronizar): sin
       repartir el ancho, los botones quedan apretados y el texto se parte. *@
    <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
        <RadzenColumn Size="3">
            <h2>Pagos</h2>
        </RadzenColumn>
        <RadzenColumn Size="9">
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Wrap="FlexWrap.Wrap">
                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary" Style="margin:0;">
                    Última actualización: @(_ultimaActualizacion?.ToString("dd/MM/yyyy") ?? "—")
                </RadzenText>
                @if (CanCreate)
                {
                    <RadzenButton Text="Nuevo"
                                  Icon="add"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Click="@AddRow"
                                  Disabled="@(_loading || _syncing)" />
                    <RadzenButton Text="Sincronizar"
                                  Icon="sync"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Click="@SincronizarDevengados"
                                  IsBusy="@_syncing"
                                  BusyText="Sincronizando..."
                                  Disabled="@_syncing" />
                }
                <RadzenButton Text="Exportar Excel"
                              Icon="download"
                              ButtonStyle="ButtonStyle.Secondary"
                              Click="@ExportarExcel"
                              IsBusy="@_exportando"
                              BusyText="Exportando..."
                              Disabled="@(_items.Count == 0 || _exportando)" />
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>

    @if (_loading)
    {
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    }
    else
    {
        <RadzenDataGrid @ref="_grid"
                        Data="@_items"
                        TItem="SAF.Application.Pagos.Dtos.PagoViewModel"
                        AllowFiltering="true"
                        AllowSorting="true"
                        AllowColumnResize="true"
                        FilterMode="FilterMode.CheckBoxList"
                        ClearFilterText="Limpiar"
                        ApplyFilterText="Aplicar"
                        PageSize="50"
                        AllowPaging="true"
                        PagerHorizontalAlign="HorizontalAlign.Center"
                        EditMode="DataGridEditMode.Single"
                        RowEdit="@OnRowEdit"
                        RowUpdate="@OnRowUpdate"
                        RowCreate="@OnRowCreate">
            <Columns>
                @* Campos IVC: solo editables en el alta manual (Id == 0); en edición quedan bloqueados. *@
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="TipoDev" Title="Tipo Dev" Width="90px">
                    <EditTemplate Context="item">
                        <RadzenTextBox @bind-Value="item.TipoDev" Disabled="@(item.Id != 0)" Placeholder="PRD" Style="width:100%"
                                       class="@GetValidationCssClass(item.Id != 0 || !string.IsNullOrWhiteSpace(item.TipoDev))" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="NroDev" Title="Nro Dev" Width="90px">
                    <EditTemplate Context="item">
                        <RadzenNumeric TValue="int" @bind-Value="item.NroDev" Disabled="@(item.Id != 0)" ShowUpDown="false" Style="width:100%"
                                       class="@GetValidationCssClass(item.Id != 0 || item.NroDev > 0)" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="FechaDevengado" Title="Fecha Devengado" Width="140px" FormatString="{0:dd/MM/yyyy}">
                    <EditTemplate Context="item">
                        <RadzenDatePicker @bind-Value="item.FechaDevengado" Disabled="@(item.Id != 0)" DateFormat="dd/MM/yyyy" Style="width:100%"
                                          class="@GetValidationCssClass(item.Id != 0 || item.FechaDevengado is not null)" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="Expediente" Title="Expediente" Width="150px">
                    <EditTemplate Context="item">
                        <RadzenTextBox @bind-Value="item.Expediente" Disabled="@(item.Id != 0)"
                                       class="@GetValidationCssClass(item.Id != 0 || SAF.Application.Common.ExpedienteKey.Normalizar(item.Expediente) is not null)"
                                       Placeholder="@SAF.Application.Common.ExpedienteKey.FormatosAceptados" Style="width:100%" />
                        @if (item.Id == 0)
                        {
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary" Style="margin:0;">
                                Formato: @SAF.Application.Common.ExpedienteKey.FormatosAceptados
                            </RadzenText>
                        }
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="Empresa" Title="Empresa" Width="200px">
                    <EditTemplate Context="item">
                        <RadzenTextBox @bind-Value="item.Empresa" Disabled="@(item.Id != 0)" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="Importe" Title="Importe" Width="120px" FormatString="{0:N2}">
                    <EditTemplate Context="item">
                        <RadzenNumeric TValue="decimal?" @bind-Value="item.Importe" Disabled="@(item.Id != 0)" ShowUpDown="false" Style="width:100%"
                                       class="@GetValidationCssClass(item.Id != 0 || item.Importe is > 0)" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="StatusDgayfNombre" Title="Status DGAyF" Width="150px">
                    <EditTemplate Context="item">
                        <RadzenDropDown @bind-Value="item.StatusDgayfOpcionId"
                                        Data="@_statusDgayfOpciones"
                                        TextProperty="Nombre"
                                        ValueProperty="Id"
                                        AllowClear="true"
                                        Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="StatusOpNombre" Title="Status OP" Width="150px">
                    <EditTemplate Context="item">
                        <RadzenDropDown @bind-Value="item.StatusOpOpcionId"
                                        Data="@_statusOpOpciones"
                                        TextProperty="Nombre"
                                        ValueProperty="Id"
                                        AllowClear="true"
                                        Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="FechaFirmaOp" Title="Fecha Firma OP" Width="140px" FormatString="{0:dd/MM/yyyy}">
                    <EditTemplate Context="item">
                        <RadzenDatePicker @bind-Value="item.FechaFirmaOp" DateFormat="dd/MM/yyyy" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="Observaciones" Title="Observaciones" Width="200px">
                    <EditTemplate Context="item">
                        <RadzenTextArea @bind-Value="item.Observaciones" Style="width:100%" Rows="2" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="Ccoo" Title="CCOO" Width="150px">
                    <EditTemplate Context="item">
                        <RadzenTextBox @bind-Value="item.Ccoo" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="FechaCcoo" Title="Fecha CCOO" Width="140px" FormatString="{0:dd/MM/yyyy}">
                    <EditTemplate Context="item">
                        <RadzenDatePicker @bind-Value="item.FechaCcoo" DateFormat="dd/MM/yyyy" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="FechaNotificacion" Title="Fecha Notificación" Width="150px" FormatString="{0:dd/MM/yyyy}">
                    <EditTemplate Context="item">
                        <RadzenDatePicker @bind-Value="item.FechaNotificacion" DateFormat="dd/MM/yyyy" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                @* Columnas calculadas/fórmula (a implementar luego): por ahora solo lectura *@
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="StatusContable" Title="Status Contable" Width="150px" />
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="SegurosTeso" Title="Seguros Teso" Width="150px" />
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="FechaDePagoNoCaf" Title="Fecha Pago No CAF" Width="155px" FormatString="{0:dd/MM/yyyy}" />
                @* Sin fecha puede significar "no se pagó nada" o "se pagó parte": el badge
                   distingue los dos casos, que antes se veían igual (o peor: como pagado). *@
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="FechaDePagoCaf" Title="Fecha Pago CAF" Width="145px" FormatString="{0:dd/MM/yyyy}">
                    <Template Context="item">
                        @if (item.CafPagoIncompleto)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Warning"
                                         Text="@($"{item.CafOpsPagadas} de {item.CafOps} OP pagadas")"
                                         Style="cursor: help; --rz-badge-font-size: 0.65rem; --rz-badge-padding: 0.05rem 0.35rem;"
                                         MouseEnter="@(el => MostrarOpsCaf(el, item))"
                                         MouseLeave="@(_ => TooltipService.Close())" />
                        }
                        else
                        {
                            @item.FechaDePagoCaf?.ToString("dd/MM/yyyy")

                            @* Con una sola OP la fecha se explica sola; con varias, el detalle. *@
                            @if (item.CafOps > 1)
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Light"
                                             Text="@($"{item.CafOps} OP")"
                                             Style="cursor: help; --rz-badge-font-size: 0.65rem; --rz-badge-padding: 0.05rem 0.35rem;"
                                             MouseEnter="@(el => MostrarOpsCaf(el, item))"
                                             MouseLeave="@(_ => TooltipService.Close())" />
                            }
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="FechaPagoTotal" Title="Fecha Pago Total" Width="150px" FormatString="{0:dd/MM/yyyy}" />
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="FechaSade" Title="Fecha SADE" Width="130px" FormatString="{0:dd/MM/yyyy}" />
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="BuzonSade" Title="Buzón SADE" Width="140px" />
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="PedidoFactura2" Title="Pedido Factura 2" Width="150px" FormatString="{0:dd/MM/yyyy}" />
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="PedidoFactura3" Title="Pedido Factura 3" Width="150px" FormatString="{0:dd/MM/yyyy}" />
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="FechaFacturaCorrecta" Title="Fecha Factura Correcta" Width="170px" FormatString="{0:dd/MM/yyyy}" />
                @* CAF SI/NO en standby: fuente PRESUPUESTO 2026 aún no implementada. Reactivar quitando Visible="false". *@
                <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Property="CafSiNo" Title="CAF" Width="80px" Visible="false">
                    <Template Context="item">
                        @(item.CafSiNo == true ? "Sí" : item.CafSiNo == false ? "No" : "")
                    </Template>
                </RadzenDataGridColumn>
                @if (CanEdit || CanDelete || CanCreate)
                {
                    <RadzenDataGridColumn TItem="SAF.Application.Pagos.Dtos.PagoViewModel" Title="Acciones" Width="140px" Frozen="true" FrozenPosition="FrozenColumnPosition.Right" Filterable="false" Sortable="false">
                        <Template Context="item">
                            @if (CanEdit)
                            {
                                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                              Click="@(() => _grid.EditRow(item))" />
                            }
                            @if (CanDelete)
                            {
                                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                              Click="@(() => DeleteRow(item))" />
                            }
                        </Template>
                        <EditTemplate Context="item">
                            <RadzenButton Icon="save" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small"
                                          Click="@(() => GuardarFila(item))" />
                            <RadzenButton Icon="cancel" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                          Click="@(() => CancelEdit(item))" />
                        </EditTemplate>
                    </RadzenDataGridColumn>
                }
            </Columns>
        </RadzenDataGrid>
    }
</RadzenStack>

@code {
    // El tooltip es hover-only (salir del badge lo cierra: no se puede scrollear), así
    // que con muchas OPs se saldría de la pantalla; se listan las primeras y el resto
    // se resume. El detalle completo vive en la vista Expedientes CAF.
    private const int MaxLineasTooltip = 10;

    // Las OPs del expediente en CAF. Sin RadzenText: sus clases de tipografía fijan el
    // color del tema y pisan el del tooltip.
    private void MostrarOpsCaf(ElementReference origen, SAF.Application.Pagos.Dtos.PagoViewModel item)
        => TooltipService.Open(origen, _ =>
            @<RadzenStack Gap="0.5rem">
                <strong>Expediente @item.Expediente · @item.CafOpsPagadas de @item.CafOps OP pagadas</strong>

                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="4" class="rz-text-nowrap"><strong>OP</strong></RadzenColumn>
                    <RadzenColumn Size="4" class="rz-text-nowrap"><strong>Importe neto</strong></RadzenColumn>
                    <RadzenColumn Size="4" class="rz-text-nowrap"><strong>Fecha de pago</strong></RadzenColumn>
                </RadzenRow>

                @foreach (var linea in item.CafLineas.Take(MaxLineasTooltip))
                {
                    <RadzenRow Gap="1rem" AlignItems="AlignItems.Center">
                        <RadzenColumn Size="4" class="rz-text-nowrap"><span>@linea.Op</span></RadzenColumn>
                        <RadzenColumn Size="4" class="rz-text-nowrap"><span>@linea.ImporteNeto?.ToString("N2")</span></RadzenColumn>
                        <RadzenColumn Size="4" class="rz-text-nowrap">
                            <span>@(linea.FechaPago?.ToString("dd/MM/yyyy") ?? "-")</span>
                        </RadzenColumn>
                    </RadzenRow>
                }

                @if (item.CafLineas.Count > MaxLineasTooltip)
                {
                    <span>… y @(item.CafLineas.Count - MaxLineasTooltip) OP más. El detalle completo está en la vista Expedientes CAF.</span>
                }

                <small>
                    La fecha de pago CAF se informa solo cuando todas las OPs del expediente
                    están pagadas.
                </small>
            </RadzenStack>
        , new TooltipOptions
        {
            Position = TooltipPosition.Left,
            Duration = null,
            // Mismo fondo que el ítem de menú seleccionado; se compone sobre la superficie
            // base porque ese token es translúcido y el tooltip flota sobre la grilla.
            Style = "background: linear-gradient(var(--rz-primary-lighter), var(--rz-primary-lighter)), "
                  + "var(--rz-base-background-color); color: var(--rz-text-color);",
        });
}
