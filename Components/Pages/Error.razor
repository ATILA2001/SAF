@page "/Error"
@using System.Diagnostics
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@layout Layout.ErrorLayout

<PageTitle>Error</PageTitle>

<div class="rz-p-12" style="max-width: 40rem; margin: 0 auto; text-align: center;">
    <h1>Ocurrió un error inesperado</h1>
    <p>El detalle quedó registrado. Si el problema persiste, avisá a Sistemas.</p>

    @if (!string.IsNullOrEmpty(RequestId))
    {
        <p><strong>Código de referencia:</strong> <code>@RequestId</code></p>
    }

    <a href="/">Volver al inicio</a>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }

    // El código le da al usuario algo concreto para reportar y a Sistemas la clave
    // para encontrar la excepción en los logs (coincide con el TraceIdentifier).
    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
