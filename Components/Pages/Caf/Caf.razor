@page "/caf"
@inherits SAF.Components.GridPageBase<SAF.Application.Caf.Dtos.CafViewModel>

<PageTitle>CAF</PageTitle>

<RadzenStack>
    <GridToolbar Titulo="Expedientes CAF"
                 MostrarNuevo="@CanCreate"
                 NuevoDeshabilitado="@_loading"
                 OnNuevo="@AddRow"
                 CargandoResto="@_cargandoResto"
                 Exportando="@_exportando"
                 ExportarDeshabilitado="@ExportarDeshabilitado"
                 TituloExportarDeshabilitado="@MotivoExportarDeshabilitado"
                 OnExportar="@ExportarExcel"
                 OnLimpiarFiltros="@LimpiarFiltros" />

    @if (_loading)
    {
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    }
    else
    {
        @* Virtualización en lugar de paginado: scroll continuo (como la planilla)
           renderizando solo las filas visibles. Requiere el alto fijo del Style. *@
        <RadzenDataGrid @ref="_grid"
                        Data="@_items"
                        TItem="SAF.Application.Caf.Dtos.CafViewModel"
                        AllowFiltering="true"
                        AllowSorting="true"
                        AllowColumnResize="true"
                        FilterMode="FilterMode.CheckBoxList"
                        ClearFilterText="Limpiar"
                        ApplyFilterText="Aplicar"
                        EmptyText="No hay filas para mostrar. Si aplicaste filtros, podés quitarlos con el botón de la barra superior."
                        AllowPaging="false"
                        AllowVirtualization="true"
                        Style="height: calc(100vh - 15rem)"
                        EditMode="DataGridEditMode.Single"
                        RowEdit="@OnRowEdit"
                        RowUpdate="@OnRowUpdate"
                        RowCreate="@OnRowCreate">
            <Columns>
                @* Año y Expediente identifican la fila: quedan fijos al scrollear las
                   columnas de la derecha (misma regla que en Pagos y Status). *@
                <RadzenDataGridColumn TItem="SAF.Application.Caf.Dtos.CafViewModel" Property="Anio" Title="Año" Width="120px" Frozen="true" />
                <RadzenDataGridColumn TItem="SAF.Application.Caf.Dtos.CafViewModel" Property="Expediente" Title="Expediente" Width="230px" Frozen="true">
                    <EditTemplate Context="item">
                        <ExpedienteEditor @bind-Value="item.Expediente" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.Caf.Dtos.CafViewModel" Property="Op" Title="OP" Width="130px">
                    <EditTemplate Context="item">
                        <RadzenTextBox @bind-Value="item.Op" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.Caf.Dtos.CafViewModel" Property="Beneficiario" Title="Beneficiario" Width="200px">
                    <EditTemplate Context="item">
                        <RadzenTextBox @bind-Value="item.Beneficiario" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.Caf.Dtos.CafViewModel" Property="ImporteNeto" Title="Importe Neto" Width="145px" FormatString="{0:N2}" TextAlign="TextAlign.Right">
                    <EditTemplate Context="item">
                        <RadzenNumeric @bind-Value="item.ImporteNeto" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.Caf.Dtos.CafViewModel" Property="Iibb" Title="IIBB (9010/8)" Width="170px" FormatString="{0:N2}" TextAlign="TextAlign.Right">
                    <EditTemplate Context="item">
                        <RadzenNumeric @bind-Value="item.Iibb" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.Caf.Dtos.CafViewModel" Property="Cuenta" Title="Cuenta" Width="140px">
                    <EditTemplate Context="item">
                        <RadzenTextBox @bind-Value="item.Cuenta" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.Caf.Dtos.CafViewModel" Property="FechaPago" Title="Fecha Pago" Width="150px" FormatString="{0:dd/MM/yyyy}">
                    <EditTemplate Context="item">
                        <RadzenDatePicker @bind-Value="item.FechaPago" DateFormat="dd/MM/yyyy" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.Caf.Dtos.CafViewModel" Property="Cargado" Title="Cargado" Width="160px" FormatString="{0:dd/MM/yyyy HH:mm}">
                    <EditTemplate Context="item">
                        <RadzenDatePicker @bind-Value="item.Cargado" ShowTime="true" DateFormat="dd/MM/yyyy HH:mm" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.Caf.Dtos.CafViewModel" Property="CcPagadora" Title="CC Pagadora" Width="165px">
                    <EditTemplate Context="item">
                        <RadzenTextBox @bind-Value="item.CcPagadora" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.Caf.Dtos.CafViewModel" Property="Pase" Title="Pase" Width="140px">
                    <EditTemplate Context="item">
                        <RadzenTextBox @bind-Value="item.Pase" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SAF.Application.Caf.Dtos.CafViewModel" Property="Revisado" Title="Revisado" Width="160px" FormatString="{0:dd/MM/yyyy HH:mm}">
                    <EditTemplate Context="item">
                        <RadzenDatePicker @bind-Value="item.Revisado" ShowTime="true" DateFormat="dd/MM/yyyy HH:mm" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                @if (CanEdit || CanDelete || CanCreate)
                {
                    <RadzenDataGridColumn TItem="SAF.Application.Caf.Dtos.CafViewModel" Title="Acciones" Width="150px" Frozen="true" FrozenPosition="FrozenColumnPosition.Right" Filterable="false" Sortable="false">
                        <Template Context="item">
                            @if (CanEdit)
                            {
                                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                              Click="@(() => _grid.EditRow(item))" title="Editar fila" />
                            }
                            @if (CanDelete)
                            {
                                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                              Click="@(() => DeleteRow(item))" title="Eliminar fila" />
                            }
                            <RadzenButton Icon="history" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                          Click="@(() => VerHistorial(item))" title="Historial de cambios" />
                        </Template>
                        <EditTemplate Context="item">
                            <RadzenButton Icon="save" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small"
                                          Click="@(() => GuardarFila(item))" title="Guardar cambios" />
                            <RadzenButton Icon="cancel" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                          Click="@(() => CancelEdit(item))" title="Cancelar edición" />
                        </EditTemplate>
                    </RadzenDataGridColumn>
                }
            </Columns>
            <FooterTemplate>
                @* View y no _items: es lo que queda a la vista con los filtros aplicados. *@
                <GridFooterTotales Filas="@(_grid?.View?.Count() ?? 0)"
                                   Importe="@(_grid?.View?.Sum(x => x.ImporteNeto ?? 0m) ?? 0m)"
                                   Cargando="@_cargandoResto"
                                   CargaIncompleta="@_cargaIncompleta" />
            </FooterTemplate>
        </RadzenDataGrid>
    }
</RadzenStack>
