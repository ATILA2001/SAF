<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="SAF.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <RadzenTheme Theme="@_theme" @rendermode="RenderModeForPage" />
    <HeadOutlet @rendermode="RenderModeForPage" />
</head>

<body>
    <Routes @rendermode="RenderModeForPage" />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/Radzen.Blazor/Radzen.Blazor.js?v=@(typeof(Radzen.Colors).Assembly.GetName().Version)"></script>
    <script src="js/exportHelpers.js"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Tema persistido por RadzenCookieThemeService (cookie "RadzenTheme"); el SSR
    // debe leerla para no pisarla con el valor por defecto en cada carga.
    // Default: "material" (tema claro).
    private string _theme = "material";

    // Sin prerender: con prerender, cada vista ejecuta OnInitializedAsync DOS veces
    // (SSR + circuito interactivo), duplicando toda la carga de datos contra IVC/SAF.
    private static readonly IComponentRenderMode InteractiveServerSinPrerender =
        new InteractiveServerRenderMode(prerender: false);

    // /Account y /Error renderizan estáticos: Account no necesita circuito, y la
    // página de error tiene que dibujarse aunque SignalR o la base estén caídos
    // (además, solo en SSR hay HttpContext para el código de referencia).
    private IComponentRenderMode? RenderModeForPage =>
        HttpContext.Request.Path.StartsWithSegments("/Account") || HttpContext.Request.Path.StartsWithSegments("/Error")
            ? null
            : InteractiveServerSinPrerender;

    protected override void OnInitialized()
        => _theme = HttpContext.Request.Cookies["RadzenTheme"] is { Length: > 0 } t ? t : "material";
}
