@* Pie de las grillas: cantidad de filas y, en las que manejan importes (Pagos,
   Status Contabilidad, CAF), la suma de las filas visibles respetando los filtros
   aplicados (se calcula sobre grid.View, la vista filtrada y ordenada de la grilla).
   Sin Importe se muestra solo el conteo: es el caso de Seguros, donde la hoja no
   usa el importe. *@

<RadzenStack Orientation="Orientation.Vertical" Class="rz-p-4 rz-w-100" Style="gap:0.5rem;">
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
        <RadzenLabel Text="@TextoFilas" />
        @if (Importe is decimal importe)
        {
            <RadzenLabel Text="@($"Importe total: {importe:N2}{Sufijo}")" />
        }
    </RadzenStack>
</RadzenStack>

@code {
    [Parameter, EditorRequired] public int Filas { get; set; }
    /// <summary>Suma de los importes visibles. Sin valor, el pie muestra solo el conteo.</summary>
    [Parameter] public decimal? Importe { get; set; }

    /// <summary>Total de filas cargadas: con filtros activos el pie muestra "N de M".</summary>
    [Parameter] public int? TotalFilas { get; set; }

    // "120 de 1.450" solo cuando hay filtros recortando la vista: es la señal de que
    // lo que se ve (y se suma) no es todo lo que hay.
    // El sufijo viaja con el importe cuando hay importe; sin el, se cuelga del conteo:
    // es el unico aviso de que la carga sigue en curso o quedo incompleta.
    private string TextoFilas =>
        (TotalFilas is int total && total != Filas
            ? $"Filas: {Filas:N0} de {total:N0} (vista filtrada)"
            : $"Filas: {Filas:N0}")
        + (Importe is null ? Sufijo : string.Empty);

    /// <summary>La carga de fondo sigue trayendo filas: la suma es parcial.</summary>
    [Parameter] public bool Cargando { get; set; }

    /// <summary>La carga de fondo falló: la suma quedó incompleta hasta recargar.</summary>
    [Parameter] public bool CargaIncompleta { get; set; }

    private string Sufijo =>
        CargaIncompleta ? " (carga incompleta: recargá la vista)"
        : Cargando ? " (cargando…)"
        : string.Empty;
}
